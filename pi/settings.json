{
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-lens",
    "npm:cc-safety-net",
    "npm:pi-quiet-tools",
    "npm:pi-cc-extensions",
    "npm:pi-footer",
    "npm:@pi-plugins/checkpoint"
