# ghostty config — https://ghostty.org/docs/config
# NOTE: no trailing comments supported; comments must own their line.

theme = Spacegray Eighties Dull

font-family = Monaspace Argon
font-size = 14
font-family-bold = Monaspace Argon
font-style-bold = SemiBold
font-family-italic = Monaspace Argon
font-style-italic = Italic
font-family-bold-italic = Monaspace Argon
font-style-bold-italic = SemiBold Italic

font-feature = -calt, -liga, -dlig
adjust-cell-height = 10%
# macOS only
font-thicken = true
font-thicken-strength = 50

cursor-style = block
# whole-list replacement; ghostty default: cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo,path

window-padding-y = 4,4
window-padding-x = 10,10

macos-option-as-alt = left

bell-features = no-system,no-audio,no-attention,no-title,no-border

confirm-close-surface = false
