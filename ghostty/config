# Fonts
font-size = 14
font-family = Monaspace Argon
font-style-bold = SemiBold
font-style-bold-italic = SemiBold Italic
font-synthetic-style = no-bold,no-italic,no-bold-italic
font-feature = -calt,-liga,-dlig

# Theme
theme = Spacegray Eighties Dull

# Window
window-padding-x = 10
window-padding-y = 4,2
scrollbar = never

# Titlebar
macos-titlebar-style = tabs
macos-window-shadow = false
macos-option-as-alt = true

# Cursor
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Mouse and clipboard
copy-on-select = false
right-click-action = copy-or-paste

# Disable bell indicators.
bell-features = no-attention,no-title
