# ghostty config — https://ghostty.org/docs/config
# NOTE: no trailing comments supported; comments must own their line.

theme = Kanagawa Dragon

font-family = Fira Mono
font-style = Medium
font-size = 14

# Fira Mono ships calt and dlig but no liga, so `-liga` would be a no-op
font-feature = -calt, -dlig
adjust-cell-height = 10%

# Opt-in upstream: they give remote hosts a usable TERM (ghostty's terminfo,
# falling back to xterm-256color when the install fails)
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

window-padding-y = 4
window-padding-x = 10
window-padding-balance = true

macos-option-as-alt = left

bell-features = no-attention,no-title

confirm-close-surface = false
