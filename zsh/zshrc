# Zsh config without a framework. Keep login PATH in zprofile; keep
# interactive behavior here.

unset ZIM_HOME ZIM_CONFIG_FILE ZSH_AUTOSUGGEST_MANUAL_REBIND

# PATH
if [[ -d /opt/homebrew/bin ]]; then
  path=(
    /opt/homebrew/bin
    /opt/homebrew/sbin
    $path
  )
fi
[[ -d $HOME/.local/bin ]] && path=($HOME/.local/bin $path)
[[ -d $HOME/.local/share/mise/shims ]] && path=($HOME/.local/share/mise/shims $path)
[[ -d $HOME/.cargo/bin ]] && path=($HOME/.cargo/bin $path)
[[ -d $HOME/.local/share/bob/nvim-bin ]] && path=($HOME/.local/share/bob/nvim-bin $path)

export VOLTA_HOME=${VOLTA_HOME:-$HOME/.volta}
[[ -d $VOLTA_HOME/bin ]] && path=($VOLTA_HOME/bin $path)
[[ -d $HOME/.local/bin ]] && path=($HOME/.local/bin $path)
[[ -d $HOME/.opencode/bin ]] && path=($HOME/.opencode/bin $path)

typeset -U path PATH
export PATH

# Locale
export LANG=en_US.UTF-8
export LC_MESSAGES=en_US.UTF-8
unset LC_ALL

# Editor
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
  alias vim=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
  export VISUAL=vim
else
  export EDITOR=vi
  export VISUAL=vi
fi

[[ -o interactive ]] || return 0

if [[ -n ${_DOTFILES_ZSH_INTERACTIVE_LOADED:-} ]]; then
  return 0
fi
typeset -g _DOTFILES_ZSH_INTERACTIVE_LOADED=1

# History
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=10000
SAVEHIST=10000
setopt append_history
setopt extended_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt share_history

# Shell behavior
setopt auto_cd
setopt interactive_comments
setopt no_beep
bindkey -e

# Completion
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Tooling
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias j=z
fi

if command -v fzf >/dev/null 2>&1; then
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
  fi
  export FZF_DEFAULT_OPTS='--height 50% --layout=default --border'
  if [[ -t 0 && -t 1 ]]; then
    source <(fzf --zsh)
  fi
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --long --color=always --no-user'
  alias l='eza --color=always --no-user'
  alias la='eza -la --color=always --no-user'
fi

if command -v lazygit >/dev/null 2>&1; then
  alias lg=lazygit
fi

yy() {
  if ! command -v yazi >/dev/null 2>&1; then
    echo 'yy: yazi is not installed' >&2
    return 127
  fi

  local cwd_file cwd
  cwd_file=$(mktemp "${TMPDIR:-/tmp}/zsh-yazi-cwd.XXXXXX") || return 1
  yazi "${@}" --cwd-file="$cwd_file"
  cwd=$(command cat "$cwd_file") || true
  command rm -f "$cwd_file"

  if [[ -n $cwd && $cwd != "$PWD" ]]; then
    builtin cd -- "$cwd" || return 1
  fi
}

tree() {
  if command -v eza >/dev/null 2>&1; then
    eza --tree --level=3 --all --ignore-glob='.git' --color=always "${@}"
  elif command -v tree >/dev/null 2>&1; then
    command tree "${@}"
  else
    echo 'tree: neither eza nor tree is installed' >&2
    return 127
  fi
}

dtree() {
  if ! command -v eza >/dev/null 2>&1; then
    echo 'dtree: eza is not installed' >&2
    return 127
  fi
  eza --tree --level=3 --all --only-dirs --ignore-glob='.git' --color=always "${@}"
}

if command -v starship >/dev/null 2>&1 && [[ -t 1 ]]; then
  eval "$(starship init zsh)"
fi
