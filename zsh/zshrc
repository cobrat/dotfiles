# Non-login shells: hardcode brew's env instead of eval-ing shellenv (~10ms).
if [[ -f /opt/homebrew/bin/brew ]] && (( ! ${+commands[brew]} )); then
  export HOMEBREW_PREFIX="/opt/homebrew" HOMEBREW_CELLAR="/opt/homebrew/Cellar" HOMEBREW_REPOSITORY="/opt/homebrew"
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}" INFOPATH="/opt/homebrew/share/info${INFOPATH+:$INFOPATH}"
fi

export LANG=en_US.UTF-8
unsetopt beep   # zsh stops sending BEL; ghostty ignores it anyway (bell-features)

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[[ -d "$ZINIT_HOME" ]] || { mkdir -p "${ZINIT_HOME:h}"; git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"; }
source "${ZINIT_HOME}/zinit.zsh"

# Order matters: fzf-tab before widget-wrapping plugins, autosuggestions
# before syntax-highlighting, syntax-highlighting last.
zinit light zsh-users/zsh-completions
zinit light Aloxaf/fzf-tab

# Prompt: yellow user@host, cyan path, magenta branch; green/red > on its own line
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b%f %F{yellow}(%a)%f'
setopt PROMPT_SUBST   # vcs_info_msg_0_ in PROMPT renders literally without it
precmd() { vcs_info }
PROMPT='
%F{yellow}%n@%m%f %F{cyan}%~%f${vcs_info_msg_0_}
%(?.%F{green}.%F{red})>%f '

zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting
zinit snippet OMZP::uv

# nvm: PATH gets the default version now, nvm.sh itself only on first use (~250ms).
export NVM_DIR="$HOME/.nvm"

# Chase alias chains: lts/* -> lts/krypton -> v24.x.x
() {
  local _p="$NVM_DIR/alias/default" _v
  while [[ -f "$_p" ]]; do
    _v="$(<"$_p")"; _p="$NVM_DIR/versions/node/$_v"
    [[ -d "$_p/bin" ]] || _p="$NVM_DIR/alias/$_v"
  done
  [[ -d "$_p/bin" ]] && path=("$_p/bin" $path)
}

function _lazy_nvm_load() {
  unfunction nvm node npm npx corepack 2>/dev/null
  zinit snippet OMZP::nvm   # full nvm.sh + OMZ .nvmrc auto-use
  zinit cdreplay -q
}
for _cmd in nvm node npm npx corepack; do
  eval "function $_cmd { _lazy_nvm_load; $_cmd \"\$@\" }"
done
unset _cmd

# Plain compinit: the "skip if .zcompdump is fresh" trick needs extended_glob
# and an unquoted glob qualifier for ~15ms — not worth it.
autoload -Uz compinit
compinit

zinit cdreplay -q

bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

HISTSIZE=50000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_find_no_dups
setopt extended_history

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview '${_LS_PREVIEW} $realpath'

# --color on GNU/uutils ls, -G on BSD
if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls -la --color=auto'
  _LS_PREVIEW='ls --color=auto'
else
  alias ls='ls -la -G'
  _LS_PREVIEW='ls -G'
fi
alias lg='lazygit'

# opencode
export PATH=/Users/wzh/.opencode/bin:$PATH

# yazi, then cd to the directory you quit in
function yy() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

path=("$HOME/.local/bin" $path)

eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
