# Homebrew fallback for non-login shells (login shells already get the full
# `eval "$(brew shellenv)"` from ~/.zprofile). Hardcoded instead of eval-ing
# the brew script to save a ~10ms subprocess; skip if brew already in PATH.
if [[ -f /opt/homebrew/bin/brew ]] && (( ! ${+commands[brew]} )); then
  export HOMEBREW_PREFIX="/opt/homebrew" HOMEBREW_CELLAR="/opt/homebrew/Cellar" HOMEBREW_REPOSITORY="/opt/homebrew"
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}" INFOPATH="/opt/homebrew/share/info${INFOPATH+:$INFOPATH}"
fi

# Locale: English messages/collation, UTF-8 content
export LANG=en_US.UTF-8

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in zsh plugins
# Order matters (per upstream docs):
#   - completions first, fzf-tab after compinit but BEFORE widget-wrapping plugins
#   - zsh-autosuggestions before zsh-syntax-highlighting
#   - zsh-syntax-highlighting must be sourced LAST
zinit light zsh-users/zsh-completions
zinit light Aloxaf/fzf-tab

# Prompt: zsh built-ins only (vcs_info) — no prompt plugin, ASCII by
# construction, branch-only (instant even in huge repos):
#   ~/path  branch
#   >                  (green, turns red after a failed command)
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b%f %F{yellow}(%a)%f'
# PROMPT contains ${vcs_info_msg_0_}; without this it renders literally.
setopt PROMPT_SUBST
precmd() { vcs_info }
# Leading newline = one blank line between command output and the next prompt.
PROMPT='
%F{cyan}%~%f${vcs_info_msg_0_}
%(?.%F{green}.%F{red})>%f '

zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting

# Add in snippets
zinit snippet OMZP::uv

# nvm lazy loading: source nvm.sh only on first use (~250ms saved at startup).
# The default version's bin dir is resolved into PATH eagerly so node is
# immediately available (LSP servers, scripts, etc.) before nvm.sh ever loads.
export NVM_DIR="$HOME/.nvm"

# Resolve the default version by chasing nvm alias chains (e.g. lts/* -> lts/krypton -> v24.x.x)
() {
  local _p="$NVM_DIR/alias/default" _v _i
  for (( _i = 0; _i < 5; _i++ )); do
    [[ -f "$_p" ]] || break
    _v="$(<"$_p")"
    _p="$NVM_DIR/versions/node/$_v"
    [[ -d "$_p/bin" ]] && break
    _p="$NVM_DIR/alias/$_v"
  done
  [[ -d "$_p/bin" ]] && path=("$_p/bin" $path)
}

function _lazy_nvm_load() {
  unfunction nvm node npm npx pnpm yarn corepack 2>/dev/null
  zinit snippet OMZP::nvm   # full nvm.sh + OMZ .nvmrc auto-use hooks
  zinit cdreplay -q
}
function nvm()      { _lazy_nvm_load; nvm "$@"; }
function node()     { _lazy_nvm_load; node "$@"; }
function npm()      { _lazy_nvm_load; npm "$@"; }
function npx()      { _lazy_nvm_load; npx "$@"; }
function pnpm()     { _lazy_nvm_load; pnpm "$@"; }
function yarn()     { _lazy_nvm_load; yarn "$@"; }
function corepack() { _lazy_nvm_load; corepack "$@"; }

# Load completions (cached: full rescan only when .zcompdump is older than 7d;
# the dump only needs rebuilding when completion tools are added/removed)
autoload -Uz compinit
if [[ -n "${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+168)" ]]; then
  compinit
else
  compinit -C
fi

zinit cdreplay -q

# Keybindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# History
HISTSIZE=50000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview '${_LS_PREVIEW} $realpath'

# Aliases

# GNU ls supports --color; BSD ls (older macOS) uses -G.
if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls -la --color=auto'
  _LS_PREVIEW='ls --color=auto'
else
  alias ls='ls -la -G'
  _LS_PREVIEW='ls -G'
fi
alias lg='lazygit'

# kitty ssh kitten: shell integration + terminfo on remote hosts (kitty only)
command -v kitten >/dev/null 2>&1 && alias ssh="kitten ssh"

# Yazi: open yazi, then cd into the last visited directory on quit
function yy() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# binaries (idempotent: skip if already inherited from parent environment)
if [[ -d "$HOME/.local/bin" ]] && (( ! ${path[(Ie)$HOME/.local/bin]} )); then
  path=("$HOME/.local/bin" $path)
fi

# pi config
# Only compact genuinely large tool outputs.
export QUIET_TOOLS_MAX_CHARS=20000
export QUIET_TOOLS_MAX_LINES=400
# Keep normal read/bash compaction enabled.
export QUIET_TOOLS_COMPACT_READ=true
export QUIET_TOOLS_COMPACT_BASH=true
# Important: preserve complete subagent final results.
export QUIET_TOOLS_COMPACT_SUBAGENT=false
# Prevent accidental unbounded reads, while being less aggressive
# than quiet-tools' default 120-line limit.
export QUIET_TOOLS_READ_DEFAULT_LIMIT=200
# Safety plugin configs
export CC_SAFETY_NET_LEVEL=standard

# Shell integrations
eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
