# Environment
# Set the Homebrew environment for shells that do not load the login profile.
if [[ -f /opt/homebrew/bin/brew ]] && (( ! ${+commands[brew]} )); then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}"
  export INFOPATH="/opt/homebrew/share/info${INFOPATH+:$INFOPATH}"
fi

export LANG=en_US.UTF-8
unsetopt beep

# Plugin manager
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  mkdir -p "${ZINIT_HOME:h}"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# Load fzf-tab before plugins that change completion widgets.
zinit light zsh-users/zsh-completions
zinit light Aloxaf/fzf-tab

# Prompt
# Show the user, host, path, and Git branch above the command line.
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b%f %F{yellow}(%a)%f'
setopt PROMPT_SUBST
precmd() { vcs_info }
PROMPT='
%F{yellow}%n@%m%f %B%F{cyan}%~%f%b${vcs_info_msg_0_}
%(?.%F{green}.%F{red})>%f '

# Load autosuggestions before syntax highlighting.
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting
zinit snippet OMZP::uv

# Node.js
# Add the default Node.js version to PATH. Load nvm on first use.
export NVM_DIR="$HOME/.nvm"

# Follow aliases to find the default Node.js version.
() {
  local _p="$NVM_DIR/alias/default" _v
  while [[ -f "$_p" ]]; do
    _v="$(<"$_p")"
    _p="$NVM_DIR/versions/node/$_v"
    [[ -d "$_p/bin" ]] || _p="$NVM_DIR/alias/$_v"
  done
  [[ -d "$_p/bin" ]] && path=("$_p/bin" $path)
}

function _lazy_nvm_load() {
  unfunction nvm node npm npx corepack 2>/dev/null
  zinit snippet OMZP::nvm
  zinit cdreplay -q
}
for _cmd in nvm node npm npx corepack; do
  eval "function $_cmd { _lazy_nvm_load; $_cmd \"\$@\" }"
done
unset _cmd

# Completion
autoload -Uz compinit
compinit

# Apply plugin commands that require completion to be initialized.
zinit cdreplay -q

# Key bindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# History
HISTSIZE=50000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_find_no_dups
setopt extended_history

# Completion settings
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview '${_LS_PREVIEW} $realpath'

# Aliases
# Use --color when available. Otherwise, use the BSD -G option.
if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls -la --color=auto'
  _LS_PREVIEW='ls --color=auto'
else
  alias ls='ls -la -G'
  _LS_PREVIEW='ls -G'
fi
alias lg='lazygit'

# Yazi
# Change to the directory selected when Yazi closes.
function yy() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# Command-line tools
path=("$HOME/.local/bin" $path)

eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
